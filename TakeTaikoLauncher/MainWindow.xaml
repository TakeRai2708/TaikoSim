<Window x:Class="TakeTaikoLauncher.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="TakeTaiko ランチャー" Icon="AppIcon.png" Width="600" SizeToContent="Height"
    ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
    Background="#120A0D" Foreground="#FCEEF2" FontFamily="Yu Gothic UI" FontSize="14">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#FCEEF2" />
            <Setter Property="Background" Value="#33202A" />
            <Setter Property="BorderBrush" Value="#674050" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" CornerRadius="8" BorderThickness="1"
                                BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#F9BCCE" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#F9BCCE" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.75" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <StackPanel Margin="30">
        <DockPanel Margin="0,3,0,24">
            <Image Width="58" Height="58" Source="AppIcon.png" Margin="0,0,16,0" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="TakeTaikoSimulator" FontSize="29" FontWeight="SemiBold" />
                <TextBlock x:Name="LauncherVersion" Foreground="#BFA5AE" />
            </StackPanel>
        </DockPanel>
        <Border Background="#1B1014" BorderBrush="#432A35" BorderThickness="1" CornerRadius="13" Padding="18">
            <DockPanel>
                <Button x:Name="PlayButton" DockPanel.Dock="Right" Click="Play_Click"
                        Background="#A3041B" BorderBrush="#E23A5E" Content="ゲームを起動" />
                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="ゲーム本体" Foreground="#F9BCCE" FontWeight="SemiBold" />
                    <TextBlock x:Name="GameVersion" Margin="0,3,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
        </Border>
        <Border Background="#1B1014" BorderBrush="#432A35" BorderThickness="1" CornerRadius="13"
                Padding="18" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="アップデート" Foreground="#F9BCCE" FontWeight="SemiBold" />
                <TextBlock x:Name="Status" Margin="0,7,0,0" MinHeight="44" TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite" />
                <ProgressBar x:Name="DownloadProgress" Height="7" Margin="0,8,0,0"
                             Foreground="#E23A5E" Visibility="Collapsed"
                             AutomationProperties.Name="ダウンロード進捗" />
                <WrapPanel Margin="0,12,0,0">
                    <Button x:Name="CheckButton" Click="Check_Click" Content="更新を確認" Margin="0,0,8,0" />
                    <Button x:Name="DownloadButton" Click="Download_Click" Content="ZIP を保存"
                            Margin="0,0,8,0" Visibility="Collapsed" />
                    <Button x:Name="LaterButton" Click="Later_Click" Content="後で" Visibility="Collapsed" />
                    <Button x:Name="OpenButton" Click="Open_Click" Content="保存先を開く" Visibility="Collapsed" />
                </WrapPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
