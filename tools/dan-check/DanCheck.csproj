<Project Sdk="Microsoft.NET.Sdk">
  <!-- 段位ファイルのパーサ(Charts/Dan.cs・DanJson.cs・ChartText.cs)を実データで動かして確かめる道具。
       使い方は tools/dan-check/README.md を見てください。 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RootNamespace>DanCheck</RootNamespace>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <SrcDir>$(MSBuildThisFileDirectory)../../TaikoSim/</SrcDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="Tests.cs" />
    <Compile Include="$(SrcDir)Charts/Dan.cs" />
    <Compile Include="$(SrcDir)Charts/DanJson.cs" />
    <Compile Include="$(SrcDir)Charts/ChartText.cs" />
    <Compile Include="$(SrcDir)Charts/DanPlay.cs" />
    <Compile Include="$(SrcDir)Charts/DanUnlock.cs" />
    <Compile Include="Shim.cs" />
  </ItemGroup>
</Project>
