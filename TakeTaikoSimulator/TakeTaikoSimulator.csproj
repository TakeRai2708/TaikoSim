<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Release（配る版）は黒い画面（ターミナル）を出さない。Debug は今までどおり出す（11/26 たけらい）
		     黒い画面に出ていた文は、どちらでも Logs\TaikoSimLog_…\System\TaikoSim.log に残る -->
		<OutputType>Exe</OutputType>
		<OutputType Condition="'$(Configuration)' == 'Release'">WinExe</OutputType>
		<AssemblyName>TakeTaiko</AssemblyName>
		<RootNamespace>TakeTaikoSimulator</RootNamespace>
		<AssemblyTitle>TakeTaiko</AssemblyTitle>
		<Product>TakeTaiko</Product>
		<ApplicationIcon Condition="'$(OS)' == 'Windows_NT'">Assets/Branding/AppIcon.ico</ApplicationIcon>
		<ApplicationManifest Condition="'$(OS)' == 'Windows_NT'">app.manifest</ApplicationManifest>
		<!-- exe横の既存データを引き継ぐため、ビルド出力先は旧プロジェクトと同じ場所にする -->
		<BaseOutputPath>$(MSBuildThisFileDirectory)../TaikoSim/bin/</BaseOutputPath>
		<!-- Windows でビルドしたときは今までどおり net10.0-windows（出力先のフォルダ名も同じ）。
		     macOS などでビルドしたときは net10.0（Windows 専用の部分は、動かしたときに OperatingSystem.IsWindows() で避ける）
		     11/26 たけらい「ios、android、mac os 対応させたい」：まずは macOS から -->
		<TargetFramework Condition="'$(OS)' == 'Windows_NT'">net10.0-windows</TargetFramework>
		<TargetFramework Condition="'$(OS)' != 'Windows_NT'">net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<!-- SDF フォント(Graphics/DynamicFont.cs)で、Raylib の LoadFontData にフォントのデータを直接渡すため -->
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>

		<!-- ===== 逆コンパイル対策：Native AOT(exe を機械語にして、IL を exe に入れない) ===== -->
		<!-- ・ふつうの dotnet build では効かない。exe を作るときに下のコマンドで効く：
		         dotnet publish -r win-x64 -c Release
		     ・作るには Visual Studio の「C++ によるデスクトップ開発」が要る
		     ・JSON はリフレクションを使わないソース生成にした(Configs/AppJsonContext.cs)
		     ・フォルダ選択は Windows フォームをやめて Win32 直呼びにした(Platform/FolderPicker.cs)
		     ・Windows フォーム(UseWindowsForms)は AOT で使えないので外した -->
		<PublishAot>true</PublishAot>
		<!-- ビルドのときから AOT で問題になるコードを警告してくれる(早めに気づけるように) -->
		<IsAotCompatible>true</IsAotCompatible>
		<!-- JSON のソース生成を使う(Configs/AppJsonContext.cs)。AOT に必要 -->
		<JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
	</PropertyGroup>

	<ItemGroup>
		<EmbeddedResource Include="Assets/Branding/AppIcon.png" LogicalName="TakeTaikoSimulator.AppIcon.png" />
		<EmbeddedResource Include="Assets/Branding/Logo.png" LogicalName="TakeTaikoSimulator.Logo.png" />
		<EmbeddedResource Include="$(TakeTaikoFeedConfig)" LogicalName="TakeTaiko.UpdateFeed.json"
		                  Condition="'$(TakeTaikoFeedConfig)' != ''" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Raylib-cs" Version="8.1.0" />
		<!-- BASS(音を鳴らすライブラリ)をC#から使うためのもの。OpenTaikoと同じ版 -->
		<PackageReference Include="ManagedBass" Version="3.1.1" />
		<!-- BASS の追加部品(ミキサー・WASAPI・ASIO)をC#から使うためのもの。どれもOpenTaikoと同じ版 -->
		<PackageReference Include="ManagedBass.Mix" Version="3.1.1" />
		<PackageReference Include="ManagedBass.Wasapi" Version="3.1.1" />
		<PackageReference Include="ManagedBass.Asio" Version="3.1.1" />
	</ItemGroup>

	<ItemGroup>
		<None Update="THIRD-PARTY-NOTICES.txt">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<!-- TaikoSim-Simple スキン(Git で管理する)。ビルドすると exe の横の Skins フォルダにコピーされる -->
		<None Update="Skins\TaikoSim-Simple\**\*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<!-- 音色(ドン・カッの音)。ビルドすると exe の横の HitSounds フォルダにコピーされる(OpenTaiko の Global/HitSounds と同じ並び) -->
		<None Update="HitSounds\**\*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="Assets\Fonts\NotoSansJP-Regular.ttf">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<!-- BASS本体(64bit版)。ビルドすると exe の横にコピーされる -->
		<None Update="bass.dll" Condition="'$(OS)' == 'Windows_NT'">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<!-- BASS の追加部品(64bit版)。無くてもビルドはできる(その方式が使えないだけ) -->
		<None Update="bassmix.dll" Condition="'$(OS)' == 'Windows_NT'">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="basswasapi.dll" Condition="'$(OS)' == 'Windows_NT'">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="bassasio.dll" Condition="'$(OS)' == 'Windows_NT'">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<!-- 描画方式 DirectX 11 / Vulkan 用（Graphics/GraphicsBackend.cs）
		     raylib_angle.dll … raylib 6.0 を OpenGL ES 3.0 でビルドしたもの（tools/angle-build で作る）
		     libEGL.dll・libGLESv2.dll … ANGLE（BSD ライセンス。OpenTaiko の Libs/win-x64 から） -->
		<None Update="raylib_angle.dll" Condition="'$(OS)' == 'Windows_NT'">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="libEGL.dll" Condition="'$(OS)' == 'Windows_NT'">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="libGLESv2.dll" Condition="'$(OS)' == 'Windows_NT'">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<!-- Vulkan の入り口（Khronos Vulkan-Loader。Apache-2.0。OpenTaiko の Libs/win-x64 から）。
		     ANGLE は自分の横の vulkan-1.dll を使うので、これが無いと Vulkan で EGL を始められなかった（11/22） -->
		<None Update="vulkan-1.dll" Condition="'$(OS)' == 'Windows_NT'">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<!-- macOS 用の BASS（un4seen.com の「bass24-osx.zip」と「bassmix24-osx.zip」の中の .dylib）。
	     プロジェクトのフォルダに置いておくと、macOS でビルドしたときに実行ファイルの横へコピーされる。
	     WASAPI・ASIO は Windows だけなので、macOS は BASS（標準）だけで鳴らす -->
	<ItemGroup Condition="'$(OS)' != 'Windows_NT'">
		<None Include="libbass.dylib" Condition="Exists('libbass.dylib')">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Include="libbassmix.dylib" Condition="Exists('libbassmix.dylib')">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

</Project>
