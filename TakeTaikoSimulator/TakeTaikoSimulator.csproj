<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<AssemblyName>TakeTaikoSimulator</AssemblyName>
		<RootNamespace>TakeTaikoSimulator</RootNamespace>
		<AssemblyTitle>TakeTaikoSimulator</AssemblyTitle>
		<Product>TakeTaikoSimulator</Product>
		<ApplicationIcon>Assets/Branding/AppIcon.ico</ApplicationIcon>
		<!-- exe横の既存データを引き継ぐため、ビルド出力先は旧プロジェクトと同じ場所にする -->
		<BaseOutputPath>$(MSBuildThisFileDirectory)../TaikoSim/bin/</BaseOutputPath>
		<TargetFramework>net10.0-windows</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<!-- SDF フォント(Graphics/DynamicFont.cs)で、Raylib の LoadFontData にフォントのデータを直接渡すため -->
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>

		<!-- ===== 逆コンパイル対策：Native AOT(exe を機械語にして、IL を exe に入れない) ===== -->
		<!-- ・ふつうの dotnet build では効かない。exe を作るときに下のコマンドで効く：
		         dotnet publish -r win-x64 -c Release
		     ・作るには Visual Studio の「C++ によるデスクトップ開発」が要る
		     ・JSON はリフレクションを使わないソース生成にした(Configs/AppJsonContext.cs)
		     ・フォルダ選択は Windows フォームをやめて Win32 直呼びにした(Platform/FolderPicker.cs)
		     ・Windows フォーム(UseWindowsForms)は AOT で使えないので外した -->
		<PublishAot>true</PublishAot>
		<!-- ビルドのときから AOT で問題になるコードを警告してくれる(早めに気づけるように) -->
		<IsAotCompatible>true</IsAotCompatible>
		<!-- JSON のソース生成を使う(Configs/AppJsonContext.cs)。AOT に必要 -->
		<JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
	</PropertyGroup>

	<ItemGroup>
		<EmbeddedResource Include="Assets/Branding/AppIcon.png" LogicalName="TakeTaikoSimulator.AppIcon.png" />
		<EmbeddedResource Include="Assets/Branding/Logo.png" LogicalName="TakeTaikoSimulator.Logo.png" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Raylib-cs" Version="8.1.0" />
		<!-- BASS(音を鳴らすライブラリ)をC#から使うためのもの。OpenTaikoと同じ版 -->
		<PackageReference Include="ManagedBass" Version="3.1.1" />
		<!-- BASS の追加部品(ミキサー・WASAPI・ASIO)をC#から使うためのもの。どれもOpenTaikoと同じ版 -->
		<PackageReference Include="ManagedBass.Mix" Version="3.1.1" />
		<PackageReference Include="ManagedBass.Wasapi" Version="3.1.1" />
		<PackageReference Include="ManagedBass.Asio" Version="3.1.1" />
	</ItemGroup>

	<ItemGroup>
		<None Update="THIRD-PARTY-NOTICES.txt">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<!-- TaikoSim-Simple スキン(Git で管理する)。ビルドすると exe の横の Skins フォルダにコピーされる -->
		<None Update="Skins\TaikoSim-Simple\**\*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<!-- 音色(ドン・カッの音)。ビルドすると exe の横の HitSounds フォルダにコピーされる(OpenTaiko の Global/HitSounds と同じ並び) -->
		<None Update="HitSounds\**\*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="Assets\Fonts\NotoSansJP-Regular.ttf">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<!-- BASS本体(64bit版)。ビルドすると exe の横にコピーされる -->
		<None Update="bass.dll">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<!-- BASS の追加部品(64bit版)。無くてもビルドはできる(その方式が使えないだけ) -->
		<None Update="bassmix.dll">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="basswasapi.dll">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="bassasio.dll">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

</Project>